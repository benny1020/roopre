{
  "name": "roopre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node config/scripts/dev.mjs",
    "dev:desktop": "install-electron && electron-vite dev",
    "dev:web": "vite --config config/vite.web.config.ts",
    "server": "tsx src/server/index.ts",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.web.json",
    "build": "pnpm typecheck && electron-vite build",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node config/scripts/check-docs.mjs",
    "check": "pnpm format:check && pnpm check:docs && pnpm build && pnpm test",
    "build:mac": "pnpm build && node config/scripts/package-mac.mjs",
    "db:start": "docker compose -f config/compose.yaml up -d --wait",
    "db:stop": "docker compose -f config/compose.yaml stop",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "fastify": "5.12.5",
    "lucide-react": "0.468.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.11.4",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "electron-vite": "5.0.0"
  },
  "description": "Team-standard agent development workflow for macOS",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benny1020/roopre.git"
  },
  "license": "UNLICENSED"
}
