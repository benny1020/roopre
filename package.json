{
  "name": "roopre",
  "version": "0.4.0-beta.1",
  "files": [
    "out",
    "resources/icon.png",
    "resources/icon.icns"
  ],
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node config/scripts/dev.mjs",
    "dev:desktop": "pnpm build:native && install-electron && electron-vite dev",
    "dev:web": "vite --config config/vite.web.config.ts",
    "server": "tsx src/server/index.ts",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.web.json",
    "build": "pnpm build:native && pnpm typecheck && electron-vite build",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node config/scripts/check-docs.mjs",
    "check": "pnpm format:check && pnpm check:docs && pnpm build && pnpm test",
    "check:mac": "pnpm build && node config/scripts/package-mac.mjs --check",
    "build:mac": "pnpm build && node config/scripts/package-mac.mjs",
    "release:mac": "node config/scripts/package-mac.mjs --release",
    "verify:mac": "node config/scripts/verify-mac.mjs",
    "db:start": "docker compose -f config/compose.yaml up -d --wait",
    "db:stop": "docker compose -f config/compose.yaml stop",
    "postinstall": "install-electron",
    "build:icons": "node config/scripts/build-icons.mjs",
    "build:native": "node config/scripts/build-native.mjs",
    "runner:image": "docker build -t roopre-runner:0.2 -f config/runner.Dockerfile .",
    "test:runner": "tsx --test tests/runner.integration.ts tests/parallel.integration.ts",
    "test:web": "playwright test --config config/playwright.config.ts",
    "test:desktop": "tsx --test tests/desktop.integration.ts",
    "pr:prepare": "tsx config/scripts/pr-workflow.ts prepare",
    "pr:publish": "tsx config/scripts/pr-workflow.ts publish",
    "pr:check": "tsx config/scripts/pr-workflow.ts check",
    "pr:merge": "pnpm build:native && tsx config/scripts/pr-workflow.ts merge",
    "harness:validate": "tsx config/scripts/harness.ts validate",
    "harness:lock": "tsx config/scripts/harness.ts lock",
    "harness:schema": "tsx config/scripts/harness.ts schema",
    "test:dogfood": "pnpm build && tsx --test tests/dogfood.integration.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@xyflow/react": "12.11.6",
    "fastify": "5.12.5",
    "lucide-react": "0.468.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/asar": "4.3.0",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.11.4",
    "electron-vite": "5.0.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "description": "Team-standard agent development workflow for macOS",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benny1020/roopre.git"
  },
  "license": "UNLICENSED",
  "productName": "루프리"
}
